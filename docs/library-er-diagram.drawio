      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n%% ER Diagram - Django app \&quot;books\&quot; (source of truth: books/models.py)\n%% Physical/DB-level view: the ManyToMany is shown as its auto-created through table.\n%%\n%% Line type: \&quot;..\&quot; = non-identifying (all tables use a surrogate PK \&quot;id\&quot;;\n%%            no FK participates in a primary key, so no relationship is identifying).\n%%\n%% Table-level constraints (Mermaid has no native notation for these):\n%%   BOOK            : CHECK  \&quot;book_price_non_negative\&quot; -&gt; price &gt;= 0 OR price IS NULL\n%%   BOOK_CATEGORIES : UNIQUE (book_id, category_id)  [Django auto M2M table books_book_categories]\n%%   FAVORITE        : UNIQUE \&quot;unique_user_book_favorite\&quot; -&gt; (user_id, book_id)\n%%   FAVORITE        : Meta.ordering = (\&quot;-created_at\&quot;,)  [not a DB constraint]\n%%   FK delete rules : BOOK_CATEGORIES.book_id CASCADE, BOOK_CATEGORIES.category_id CASCADE,\n%%                     FAVORITE.user_id CASCADE, FAVORITE.book_id CASCADE\n\n    AUTH_USER {\n        int id PK\n        varchar username UK\n        varchar password\n        varchar email\n        varchar first_name\n        varchar last_name\n        boolean is_staff\n        boolean is_superuser\n        boolean is_active\n        datetime last_login\n        datetime date_joined\n    }\n\n    CATEGORY {\n        int id PK\n        varchar name UK\n    }\n\n    BOOK {\n        int id PK\n        varchar title\n        varchar author\n        varchar isbn UK\n        smallint publication_year\n        date publication_date\n        decimal price\n        text description\n        boolean is_available\n        datetime created_at\n        datetime updated_at\n    }\n\n    BOOK_CATEGORIES {\n        int id PK\n        int book_id FK\n        int category_id FK\n    }\n\n    FAVORITE {\n        int id PK\n        int user_id FK\n        int book_id FK\n        datetime created_at\n    }\n\n    BOOK      ||..o{ BOOK_CATEGORIES : \&quot;categories\&quot;\n    CATEGORY  ||..o{ BOOK_CATEGORIES : \&quot;books\&quot;\n    AUTH_USER ||..o{ FAVORITE : \&quot;favorites\&quot;\n    BOOK      ||..o{ FAVORITE : \&quot;favorited_by\&quot;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="mpEmEAjQO0abQTLTThws-1">
